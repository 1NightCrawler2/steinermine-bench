    given-names: "Kürşat"
    orcid: "https://orcid.org/0000-0002-2710-9562"
    affiliation: "Department of Mining Engineering, Istanbul Technical University"
    email: "hasozdemir@itu.edu.tr"

keywords:
  - mine planning
  - underground mining
  - ramp network design
  - Steiner tree
  - directed Steiner arborescence
  - voxel model
  - Barton Q-system
  - rock mass classification
  - geotechnical engineering
  - combinatorial optimisation
  - benchmark dataset

